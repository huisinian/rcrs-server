import org.apache.log4j.Logger;
import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;

public class ReadConfig {
    // 初始化Log4j日志对象
    private static final Logger logger = Logger.getLogger(ReadConfig.class);

    public static void main(String[] args) {
        String configPath = "adf-sample-agent-java/config/module.cfg";
        BufferedReader reader = null;

        try {
            // INFO日志：关键步骤记录
            logger.info("开始读取配置文件：" + configPath);

            reader = new BufferedReader(new FileReader(configPath));
            String line;
            while ((line = reader.readLine()) != null) {
                // 解析并输出配置项
                System.out.println("配置项：" + line);
                logger.debug("解析配置项：" + line); // DEBUG日志：详细调试信息
            }
            logger.info("配置文件读取完成");
        } catch (IOException e) {
            // ERROR日志：错误信息
            logger.error("读取配置文件失败：文件不存在或路径错误", e);
            e.printStackTrace();
        } finally {
            // 关闭流资源，避免资源泄漏
            try {
                if (reader != null) {
                    reader.close();
                    logger.info("文件流已关闭");
                }
            } catch (IOException e) {
                logger.error("关闭文件流失败", e);
            }
        }
    }
}